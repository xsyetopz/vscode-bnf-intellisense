{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RBNF",
  "scopeName": "source.rbnf",
  "patterns": [
    { "include": "#comment" },
    { "include": "#rule-definition" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.rbnf",
      "match": ";[^\\r\\n]*"
    },
    "rule-definition": {
      "match": "^\\s*(<[^<>\\r\\n]+>)(\\s*)(::=)",
      "captures": {
        "1": { "name": "entity.name.function.rule.rbnf" },
        "3": { "name": "keyword.operator.assignment.rbnf" }
      }
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#double-string" },
        { "include": "#single-string" },
        { "include": "#alternation" },
        { "include": "#ellipsis" },
        { "include": "#group-delimiter" },
        { "include": "#identifier" }
      ]
    },
    "double-string": {
      "name": "string.quoted.double.rbnf",
      "begin": "(\\\")",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.rbnf" } },
      "end": "(\\\")|(?=\\n)",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.rbnf" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "single-string": {
      "name": "string.quoted.single.rbnf",
      "begin": "(')",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.rbnf" } },
      "end": "(')|(?=\\n)",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.rbnf" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "string-escape": {
      "name": "constant.character.escape.rbnf",
      "match": "\\\\(?:x[0-9A-Fa-f]{2}|.)"
    },
    "alternation": {
      "name": "keyword.operator.alternation.rbnf",
      "match": "\\|"
    },
    "ellipsis": {
      "name": "keyword.operator.repetition.ellipsis.rbnf",
      "match": "\\.\\.\\."
    },
    "group-delimiter": {
      "name": "punctuation.definition.group.rbnf",
      "match": "[()\\[\\]{}]"
    },
    "identifier": {
      "name": "variable.other.rule.rbnf",
      "match": "<[^<>\\r\\n]+>|[A-Za-z_][A-Za-z0-9_.:-]*(?<![.:-])"
    }
  }
}
