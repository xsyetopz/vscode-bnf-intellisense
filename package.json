{
  "name": "vscode-bnf-intellisense",
  "type": "module",
  "displayName": "BNF-family Syntax Highlighting and Intellisense",
  "description": "Edit ABNF, BNF, W3C XML EBNF, and RBNF files with highlighting, navigation, diagnostics, formatting, and snippets.",
  "version": "0.3.0",
  "author": {
    "name": "xsyetopz"
  },
  "license": "MIT",
  "private": true,
  "publisher": "xsyetopz",
  "homepage": "https://github.com/xsyetopz/vscode-bnf-intellisense",
  "repository": {
    "type": "git",
    "url": "https://github.com/xsyetopz/vscode-bnf-intellisense.git"
  },
  "bugs": {
    "url": "https://github.com/xsyetopz/vscode-bnf-intellisense/issues"
  },
  "keywords": [
    "BNF",
    "EBNF",
    "ABNF",
    "RBNF",
    "RFC 5234",
    "RFC 7405",
    "RFC 5511",
    "W3C XML EBNF",
    "Backus-Naur Form",
    "grammar",
    "syntax highlighting",
    "parser",
    "language server",
    "intellisense",
    "formatter",
    "linter",
    "diagnostics"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#0d1b2a",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.91.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "abnf",
        "aliases": [
          "ABNF",
          "abnf"
        ],
        "extensions": [
          ".abnf"
        ],
        "configuration": "abnf-language-configuration.json",
        "icon": {
          "light": "assets/logo.png",
          "dark": "assets/logo.png"
        }
      },
      {
        "id": "bnf",
        "aliases": [
          "BNF",
          "bnf"
        ],
        "extensions": [
          ".bnf"
        ],
        "configuration": "bnf-language-configuration.json",
        "icon": {
          "light": "assets/logo.png",
          "dark": "assets/logo.png"
        }
      },
      {
        "id": "ebnf",
        "aliases": [
          "EBNF",
          "ebnf"
        ],
        "extensions": [
          ".ebnf"
        ],
        "configuration": "ebnf-language-configuration.json",
        "icon": {
          "light": "assets/logo.png",
          "dark": "assets/logo.png"
        }
      },
      {
        "id": "rbnf",
        "aliases": [
          "RBNF",
          "rbnf"
        ],
        "extensions": [
          ".rbnf"
        ],
        "configuration": "bnf-language-configuration.json",
        "icon": {
          "light": "assets/logo.png",
          "dark": "assets/logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "abnf",
        "scopeName": "source.abnf",
        "path": "syntaxes/abnf.tmLanguage.json"
      },
      {
        "language": "bnf",
        "scopeName": "source.bnf",
        "path": "syntaxes/bnf.tmLanguage.json"
      },
      {
        "language": "ebnf",
        "scopeName": "source.ebnf",
        "path": "syntaxes/ebnf.tmLanguage.json"
      },
      {
        "language": "rbnf",
        "scopeName": "source.rbnf",
        "path": "syntaxes/rbnf.tmLanguage.json"
      },
      {
        "scopeName": "text.html.markdown.abnf.codeblock",
        "path": "syntaxes/abnf-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.abnf": "abnf"
        }
      },
      {
        "scopeName": "text.html.markdown.bnf.codeblock",
        "path": "syntaxes/bnf-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bnf": "bnf"
        }
      },
      {
        "scopeName": "text.html.markdown.ebnf.codeblock",
        "path": "syntaxes/ebnf-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ebnf": "ebnf"
        }
      },
      {
        "scopeName": "text.html.markdown.rbnf.codeblock",
        "path": "syntaxes/rbnf-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rbnf": "rbnf"
        }
      }
    ],
    "snippets": [
      {
        "language": "abnf",
        "path": "snippets/abnf.json"
      },
      {
        "language": "bnf",
        "path": "snippets/bnf.json"
      },
      {
        "language": "ebnf",
        "path": "snippets/ebnf.json"
      },
      {
        "language": "rbnf",
        "path": "snippets/rbnf.json"
      }
    ],
    "configuration": {
      "title": "BNF IntelliSense",
      "properties": {
        "bnf.diagnostics.enable": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Show parser and rule diagnostics for ABNF, BNF, EBNF, and RBNF files."
        },
        "bnf.diagnostics.unusedRules": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Show a hint when a rule is not referenced by another rule."
        },
        "bnf.diagnostics.undefinedReferences": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Show an error when a rule reference has no definition in the file."
        },
        "bnf.diagnostics.leftRecursion": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "hint",
          "description": "Severity for rules that are directly or indirectly left-recursive. The message shows the cycle. Use \"off\" to disable."
        },
        "bnf.diagnostics.unproductiveRules": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for rules that can never derive a terminal string, such as rules whose every alternative needs a non-terminating rule."
        },
        "bnf.diagnostics.unreachableRules": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "information",
          "description": "Severity for referenced rules that cannot be reached from the start rule (the first rule). Rules nothing references are covered by the unused-rules hint."
        },
        "bnf.diagnostics.duplicateAlternatives": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for identical alternatives inside one choice."
        },
        "bnf.diagnostics.emptyAlternatives": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "hint",
          "description": "Severity for alternatives that match only the empty string, such as a leading or trailing separator."
        },
        "bnf.diagnostics.didYouMean": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Suggest the closest defined rule (including case and angle-bracket mismatches) on undefined references."
        },
        "bnf.diagnostics.caseSensitiveStrings": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "markdownDescription": "ABNF only. Show a hint on quoted strings with uppercase letters, which also match other letter cases (RFC 5234). The quick fix rewrites them as case-sensitive `%s\"...\"` (RFC 7405)."
        },
        "bnf.formatting.alignEquals": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Align assignment operators across consecutive rule definitions."
        },
        "bnf.formatting.continuationIndent": {
          "scope": "language-overridable",
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Number of spaces to indent wrapped rule-body lines."
        },
        "bnf.formatting.alternativeIndent": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "align",
            "indent"
          ],
          "default": "align",
          "enumDescriptions": [
            "Align alternatives under the first expression item",
            "Indent alternatives by bnf.formatting.continuationIndent spaces"
          ],
          "description": "Choose how formatter indents alternatives on continuation lines."
        },
        "bnf.formatting.blankLinesBetweenRules": {
          "scope": "language-overridable",
          "type": "number",
          "default": 1,
          "description": "Number of blank lines the formatter keeps between rule definitions."
        },
        "bnf.formatting.breakAlternatives": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "always",
            "auto",
            "never"
          ],
          "default": "always",
          "enumDescriptions": [
            "Put each top-level alternative on its own line",
            "Keep alternatives inline when the line fits bnf.formatting.maxLineLength",
            "Do not split alternatives only because they are alternatives"
          ],
          "description": "Choose when formatter breaks top-level alternatives onto separate lines."
        },
        "bnf.formatting.maxLineLength": {
          "scope": "language-overridable",
          "type": "number",
          "default": 80,
          "description": "Wrap rule bodies after this column. Use 0 to disable wrapping."
        },
        "bnf.formatting.alignProductionNumbers": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Align EBNF production numbers, such as [1], with rule names."
        },
        "bnf.formatting.preserveCommentSpacing": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Keep blank-line spacing around standalone comments when formatting."
        },
        "bnf.formatting.trimTrailingBlankLines": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Remove extra blank lines at the end of the file before final-newline handling."
        },
        "bnf.formatting.preserveContinuationLineBreaks": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Keep existing indented continuation line breaks instead of reflowing them."
        },
        "bnf.formatting.spaceBeforeInlineComment": {
          "scope": "language-overridable",
          "type": "number",
          "default": 2,
          "description": "Number of spaces before inline semicolon comments in rule bodies."
        },
        "bnf.formatting.insertFinalNewline": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "End formatted files with one final newline."
        },
        "bnf.codeLens.references": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Show a code lens with the number of references above each rule definition."
        },
        "bnf.inlayHints.referenceCount": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Show an inlay hint with the number of references after each rule name."
        },
        "bnf.inlayHints.recursion": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Show an inlay hint on rules that reference themselves directly."
        },
        "bnf.inlayHints.unusedMarker": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Show an inlay hint on rules with no references."
        },
        "bnf.inlayHints.syntaxDetails": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Show inlay hints for syntax details such as repetitions and terminals."
        },
        "bnf.semanticHighlighting.mode": {
          "scope": "language-overridable",
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use full semantic tokens until the file exceeds bnf.semanticHighlighting.maxTokens, then only rule names and references",
            "Always use semantic tokens",
            "Use TextMate grammar highlighting only"
          ],
          "description": "Choose whether grammar files use semantic highlighting."
        },
        "bnf.semanticHighlighting.maxTokens": {
          "scope": "language-overridable",
          "type": "number",
          "default": 20000,
          "minimum": 0,
          "description": "Maximum semantic tokens in auto mode before dropping operators, strings, numbers, and comments (TextMate highlights those) and keeping only rule names and references. Use 0 for no limit."
        }
      }
    },
    "commands": [
      {
        "command": "bnf.sortRules",
        "title": "Sort Rules Alphabetically",
        "category": "BNF"
      },
      {
        "command": "bnf.sortRulesByDependency",
        "title": "Sort Rules by Dependency",
        "category": "BNF"
      },
      {
        "command": "bnf.convertDialect",
        "title": "Convert to Another Dialect...",
        "category": "BNF"
      },
      {
        "command": "bnf.showRailroadDiagram",
        "title": "Show Railroad Diagram",
        "category": "BNF",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bnf.sortRules",
          "when": "editorLangId =~ /^(abnf|bnf|ebnf|rbnf)$/"
        },
        {
          "command": "bnf.sortRulesByDependency",
          "when": "editorLangId =~ /^(abnf|bnf|ebnf|rbnf)$/"
        },
        {
          "command": "bnf.convertDialect",
          "when": "editorLangId =~ /^(abnf|bnf|ebnf|rbnf)$/"
        },
        {
          "command": "bnf.showRailroadDiagram",
          "when": "editorLangId =~ /^(abnf|bnf|ebnf|rbnf)$/ || activeWebviewPanelId == 'bnf.railroad'"
        }
      ],
      "editor/title": [
        {
          "command": "bnf.showRailroadDiagram",
          "when": "editorLangId =~ /^(abnf|bnf|ebnf|rbnf)$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "bench": "bun --preload ./client/src/__tests__/vscode-mock.ts client/src/bench/bench.ts",
    "biome:check": "bunx biome check . --max-diagnostics 16384",
    "biome:format": "bunx biome format . --write --max-diagnostics 16384",
    "biome:lint": "bunx biome lint . --write --max-diagnostics 16384",
    "build": "bun build ./client/src/main.ts --outdir=./dist --entry-naming=extension.cjs --external vscode --target=node --format=cjs --minify --sourcemap=linked",
    "verify": "bun run --parallel biome:check md:check typecheck",
    "md:check": "markdownlint-cli2",
    "md:fix": "markdownlint-cli2 --fix",
    "package": "bun run build && vsce package",
    "prepare": "lefthook install",
    "test": "bun test",
    "typecheck": "bun check",
    "vscode:prepublish": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/bun": "^1.4.3",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vscode/vsce-sign",
    "keytar",
    "lefthook"
  ],
  "packageManager": "bun@1.4.3"
}
