{
  "comments": {
    "blockComment": ["/*", "*/"]
  },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "([A-Za-z_][A-Za-z0-9_.:-]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:\\[[^\\]\\r\\n]+\\]\\s*)?[A-Za-z_][A-Za-z0-9_.:-]*\\s*::=",
    "decreaseIndentPattern": "^\\S"
  }
}
